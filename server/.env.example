# PostgreSQL (local)
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/updaterw?schema=public"

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"
SERVER_URL="http://localhost:5000"

# JWT
JWT_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-another-long-random-string"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Seed accounts (development only)
ADMIN_EMAIL="admin@updaterw.local"
ADMIN_PASSWORD="ChangeMeAdmin123!"
ADMIN_USERNAME="admin"
ADMIN_NAME="Updaterw Admin"
CHIEF_EDITOR_EMAIL="editor@updaterw.local"
CHIEF_EDITOR_PASSWORD="ChangeMeEditor123!"
CHIEF_EDITOR_USERNAME="editor"
CHIEF_EDITOR_NAME="Chief Editor"

# Cloudinary (optional — local disk is used when these are empty)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="updaterw"

# Uploads
MAX_IMAGE_SIZE_MB="5"
MAX_VIDEO_SIZE_MB="80"
MAX_PROFILE_SIZE_MB="3"
